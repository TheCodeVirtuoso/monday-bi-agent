# ==========================================================================
# LLM provider — pick ONE. Leave LLM_PROVIDER unset to auto-detect from
# whichever key you fill in below.
# ==========================================================================
# groq | openrouter | anthropic
LLM_PROVIDER=groq

# --- Groq (default: free tier, fastest inference) -------------------------
# Key: https://console.groq.com/keys
GROQ_API_KEY=
#
# NOTE: Groq has RETIRED the llama-3.x ids that most tutorials still cite —
# they now return 404. Verified against a live free-tier account:
#   openai/gpt-oss-120b   (default; largest, reliable tool calls)
#   openai/gpt-oss-20b    (smaller and faster)
#   qwen/qwen3.8-27b      (works)
#   qwen/qwen3.6-27b      (does NOT reliably call tools — avoid)
# List what your own account can see:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" \
#        https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b

# The free tier meters 200,000 tokens per DAY *per model*, so an exhausted
# model has healthy siblings. These are tried in order when the primary is
# rate-limited, which recovers instantly where waiting would not.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# --- OpenRouter (many models behind one key, incl. free ones) -------------
# Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free model ids end in ':free' and change often — check the model list if
# you get a "model not found" error.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# --- Anthropic (paid fallback; most reliable tool calling) ----------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ==========================================================================
# monday.com — leave blank to run against the workbooks in data/
# ==========================================================================
# Token: monday.com -> avatar -> Developers -> My access tokens
# Board ids: open a board, the URL is monday.com/boards/<id>
#
# Provision both boards from the source workbooks with:
#   python scripts/import_to_monday.py
# It prints the two ids when it finishes. Takes ~16 minutes — monday meters
# by complexity, which caps item creation at ~33/minute.
MONDAY_API_TOKEN=
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_DEALS_BOARD_ID=

# false = read the live boards (what the deployed app does).
# true  = read the workbooks in data/, so the app runs with no monday account.
# Also forced true automatically if the token or either board id is missing.
USE_MOCK_DATA=false
